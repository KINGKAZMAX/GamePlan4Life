# 正文一改就重新生成三样，挂到固定的 Release「epub-latest」上，下载链接不变：
#   EPUB        https://github.com/KINGKAZMAX/HowToLiveBetter/releases/download/epub-latest/HowToLiveBetter.epub
#   PDF         https://github.com/KINGKAZMAX/HowToLiveBetter/releases/download/epub-latest/HowToLiveBetter.pdf
#   离线单文件  https://github.com/KINGKAZMAX/HowToLiveBetter/releases/download/epub-latest/HowToLiveBetter.html
# PDF 另发一份到 Pages（见下面的 pages job）：Release 附件一律带 attachment 头强制下载，
# Pages 不带，浏览器能直接在线翻——https://kingkazmax.github.io/HowToLiveBetter/HowToLiveBetter.pdf
# PR 只生成并校验，不发布，产物在 Actions 页面的 artifact 里。
name: 电子书

on:
  push:
    branches: [main]
    paths:
      - README.md
      - index.html
      - og.png
      - ads/**
      - book/**
      - docs/*.md
      - tools/**
      - robots.txt
      - sitemap.xml
      - .github/workflows/book.yml
  pull_request:
    paths:
      - README.md
      - index.html
      - og.png
      - ads/**
      - book/**
      - docs/*.md
      - tools/**
      - robots.txt
      - sitemap.xml
      - .github/workflows/book.yml
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: book-${{ github.ref }}
  cancel-in-progress: true

env:
  PANDOC_VERSION: '3.11'
  TYPST_VERSION: '0.15.1'

jobs:
  # 交叉引用检查。单独一个 job，不挂在 build 里：锚点没补好不该连累 EPUB、PDF 和
  # 离线单文件的发布，那是两回事。PR 上照样红，main 上该发的还是发出去。
  # 本地那条链路（sync-stats.ps1）只在 Windows 上跑，而且找不到 node 时会静默跳过，
  # 外部 PR 更是完全跑不到，所以这道检查得在 CI 里有一份。零依赖，几秒钟。
  refs:
    name: 交叉引用检查
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: node tools/check-refs.mjs --check

  # 说人话检查：长度、研究行话、抽象说法。理由同上，单独一个 job，不挡发布。
  plain:
    name: 说人话检查
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: node tools/check-plain.mjs

  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: tools/epub/package-lock.json

      - run: npm ci
        working-directory: tools/epub

      - name: EPUB
        run: node tools/epub/build.mjs

      - name: 离线单文件 HTML
        run: node tools/offline/build.mjs

      - name: 装 pandoc、typst 和中文字体
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends fonts-noto-cjk
          curl -sSL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" | tar xz
          curl -sSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" | tar xJ
          echo "$PWD/pandoc-${PANDOC_VERSION}/bin" >> "$GITHUB_PATH"
          echo "$PWD/typst-x86_64-unknown-linux-musl" >> "$GITHUB_PATH"

      - name: PDF
        run: |
          typst fonts | grep -i -E 'noto (serif|sans) cjk' || echo '没找到 Noto CJK，PDF 会退到别的字体，检查 fonts-noto-cjk 这一步'
          node tools/pdf/build.mjs

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: epubcheck
        run: |
          curl -sSL -o epubcheck.zip https://github.com/w3c/epubcheck/releases/download/v5.4.0/epubcheck-5.4.0.zip
          unzip -q epubcheck.zip
          java -jar epubcheck-5.4.0/epubcheck.jar dist/HowToLiveBetter.epub

      - uses: actions/upload-artifact@v4
        with:
          name: HowToLiveBetter
          path: |
            dist/HowToLiveBetter.epub
            dist/HowToLiveBetter.pdf
            dist/HowToLiveBetter.html

      - name: 发布到 Release epub-latest
        if: github.event_name != 'pull_request'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          git tag -f epub-latest
          git push -f origin epub-latest
          notes="正文提交 ${GITHUB_SHA::7}，生成于 $(date -u -d '+8 hours' +'%Y-%m-%d %H:%M')（北京时间）。EPUB、PDF、离线单文件 HTML 三样，正文每次更新后自动重新生成，下载链接固定不变。"
          if gh release view epub-latest >/dev/null 2>&1; then
            gh release edit epub-latest --title "电子书（EPUB / PDF / 离线 HTML，自动更新）" --notes "$notes"
          else
            gh release create epub-latest --title "电子书（EPUB / PDF / 离线 HTML，自动更新）" --notes "$notes" --latest=false
          fi
          gh release upload epub-latest \
            dist/HowToLiveBetter.epub \
            dist/HowToLiveBetter.pdf \
            dist/HowToLiveBetter.html --clobber

  # 在线检索页整站 + 刚构建的 PDF 发到 GitHub Pages。Pages 部署方式必须是
  # 「GitHub Actions」（Settings → Pages → Build and deployment → Source），
  # 沿用「从分支部署」这个 job 会失败。整棵工作树一起发是为了和旧的分支根目录
  # 部署保持同一批路径：index.html 运行时要就地 fetch README.md、book/ 和 docs/，
  # robots.txt、og.png 也都在站上。PDF 放这儿的唯一目的就是在线翻——不进仓库。
  pages:
    name: Pages 部署（在线页 + PDF）
    needs: build
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/download-artifact@v4
        with:
          name: HowToLiveBetter
          path: dist

      - run: |
          rsync -a --exclude='.git' --exclude='dist' ./ site/
          cp dist/HowToLiveBetter.pdf site/

      - uses: actions/configure-pages@v5

      - uses: actions/upload-pages-artifact@v3
        with:
          path: site

      - id: deployment
        uses: actions/deploy-pages@v4
